{
  "sources": {
    "obsidian-kit": {
      "ref": "0.99.1"
    },
    "code-kit": {
      "ref": "0.78.0"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "i18n",
        "rel-path"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "pseudonymizer-source"
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "help-setting",
        "folder-suggest",
        "segmented-control",
        "status-bar-item",
        "confirm"
      ],
      "rewrite": [
        [
          "../pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "obsidian-mock",
        "kit-css"
      ]
    }
  ]
}
