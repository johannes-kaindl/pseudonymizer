{
  "sources": {
    "obsidian-kit": {
      "ref": "0.99.1"
    },
    "code-kit": {
      "ref": "0.82.0"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "fold-case",
        "i18n",
        "phone",
        "placeholder",
        "placeholder-table",
        "recovery-code",
        "rel-path",
        "secrets"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/web",
      "modules": [
        "clipboard"
      ],
      "rewrite": [
        [
          "../pure/",
          "./"
        ]
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "pseudonymizer-source"
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "clipboard",
        "confirm",
        "folder-suggest",
        "help-setting",
        "hub",
        "prompt-text",
        "secrets",
        "segmented-control",
        "status-bar-item",
        "status-indicator"
      ],
      "rewrite": [
        [
          "../pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/web/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "obsidian-mock",
        "kit-css"
      ]
    }
  ]
}
