          "../pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/web/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "obsidian-mock",
        "kit-css"
      ]
    }
  ]
